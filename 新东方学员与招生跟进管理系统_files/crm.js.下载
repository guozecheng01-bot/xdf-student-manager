/* 学员档案与招生跟进：本地浏览器存储，无远程数据请求。 */
'use strict';
let prospects = (() => { try { const a = JSON.parse(localStorage.getItem('xdf_prospects') || '[]'); return Array.isArray(a) ? a : []; } catch (_) { return []; } })();
let crmEditing = null;
let crmFollowupEditing = null;
let crmConversionId = null;
let crmToastTimer = null;

function crmEsc(value) { return String(value == null ? '' : value).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function crmToday() { const d = new Date(); return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`; }
function crmNow() { const d = new Date(); return `${crmToday()}T${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`; }
function crmNewId(prefix = 'p') { return `${prefix}_${Date.now()}_${Math.random().toString(36).slice(2,8)}`; }
function crmNextStudentId() { return Math.max(Date.now(), ...students.map(s => Number(s.id) || 0)) + 1; }
function crmDate(value) { return /^\d{4}-\d{2}-\d{2}$/.test(String(value || '')) ? String(value) : ''; }
function normalizeCRMRecord(record, type = 'student') {
  if (!record || typeof record !== 'object') return record;
  ['profile','remarks','phone'].forEach(k => { record[k] = String(record[k] || ''); });
  record.isGift = record.isGift === true;
  record.nextFollowupAt = crmDate(record.nextFollowupAt);
  record.followUps = (Array.isArray(record.followUps) ? record.followUps : []).filter(f => f && typeof f === 'object').map(f => ({
    ...f, id: f.id || crmNewId('f'), time: String(f.time || f.date || crmNow()),
    method: ['微信','电话','面谈','其他'].includes(f.method) ? f.method : '其他',
    action: String(f.action || f.description || ''), result: String(f.result || ''),
    nextPlan: String(f.nextPlan || ''), nextDate: crmDate(f.nextDate), completed: f.completed === true
  }));
  if (type === 'prospect') {
    record.id = record.id || crmNewId(); record.name = String(record.name || ''); record.course = String(record.course || '');
    record.enrollmentIntent = ['高','中','低'].includes(record.enrollmentIntent) ? record.enrollmentIntent : '未评估';
    record.status = ['待联系','跟进中','已报名','暂不报名'].includes(record.status) ? record.status : '待联系';
  } else record.renewalIntent = ['高','中','低'].includes(record.renewalIntent) ? record.renewalIntent : '未评估';
  return record;
}
function crmFind(type, id) { return (type === 'prospect' ? prospects : students).find(s => String(s.id) === String(id)); }
function crmSortedFollowups(r) { return [...(r.followUps || [])].sort((a,b) => String(b.time).localeCompare(String(a.time))); }
function crmNextDate(r) {
  const pending = (r.followUps || []).filter(f => f.nextDate && !f.completed).map(f => f.nextDate);
  if (r.nextFollowupAt) pending.push(r.nextFollowupAt);
  return pending.sort()[0] || '';
}
function crmPendingOnlyDate(r) { return (r.followUps || []).filter(f => f.nextDate && !f.completed).map(f => f.nextDate).sort()[0] || ''; }
function crmIsDue(r, type = 'student') { const d = crmNextDate(r); return !!d && d <= crmToday() && !(type === 'prospect' && (r.convertedStudentId || r.status === '暂不报名')); }
function crmIntentBadge(intent) { const v = ['高','中','低'].includes(intent) ? intent : '未评估'; return `<span class="crm-badge crm-intent-${v === '高' ? 'high' : v === '中' ? 'medium' : v === '低' ? 'low' : 'none'}">${crmEsc(v)}</span>`; }
function crmGiftBadge(record) { return record?.isGift === true ? '<span class="crm-badge crm-gift" aria-label="赠送学员">赠送</span>' : ''; }
function crmSummary(value, fallback = '未填写') { return `<span class="crm-summary" title="${crmEsc(value)}">${crmEsc(value || fallback)}</span>`; }
function crmButton(action, type, id, label, style = '') { return `<button type="button" class="crm-btn ${style}" data-crm-action="${action}" data-crm-type="${type}" data-crm-id="${crmEsc(id)}">${label}</button>`; }
function crmFollowDateCell(r, type) { const d = crmNextDate(r); return d ? `<span class="${crmIsDue(r,type) ? 'crm-due' : 'crm-muted'}">${crmEsc(d)}${crmIsDue(r,type) ? ' · 待跟进' : ''}</span>` : '<span class="crm-muted">未设置</span>'; }
function crmDashboardCell(s) {
  normalizeCRMRecord(s); const f = crmSortedFollowups(s)[0];
  return `<div class="crm-dashboard-cell"><div class="crm-inline">${crmGiftBadge(s)}${crmIntentBadge(s.renewalIntent)} ${crmButton('open','student',s.id,'维护档案','crm-btn-link')}</div>${crmSummary(s.profile,'画像待完善')}${f ? crmSummary(f.action,'暂无跟进') : ''}<div>${crmFollowDateCell(s,'student')}</div></div>`;
}
function crmToast(message, error = false) {
  const el = document.getElementById('crm-toast'); if (!el) return;
  el.textContent = message; el.classList.toggle('crm-toast-error',error); el.hidden = false;
  clearTimeout(crmToastTimer); crmToastTimer = setTimeout(() => { el.hidden = true; }, 4200);
}
function crmOpenDialog(id) { const d = document.getElementById(id); if (!d.open) d.showModal(); }
function crmCloseDialog(id) { document.getElementById(id).close(); if (id === 'crm-record-dialog') crmEditing = null; }

function renderCRMViews() {
  students.forEach(s => normalizeCRMRecord(s)); prospects.forEach(p => normalizeCRMRecord(p,'prospect'));
  const q = (document.getElementById('crm-student-search')?.value || '').trim().toLowerCase();
  const intent = document.getElementById('crm-student-intent')?.value || '';
  const giftFilter = document.getElementById('crm-student-gift')?.value || '';
  const dueOnly = document.getElementById('crm-student-due')?.checked;
  const visible = students.filter(s => (!q || [s.name,s.phone,s.course,s.teacher,s.profile,s.remarks,s.isGift ? '赠送' : '',...s.followUps.map(f=>f.action)].join(' ').toLowerCase().includes(q)) && (!intent || s.renewalIntent===intent) && (!giftFilter || s.isGift === (giftFilter === 'gift')) && (!dueOnly || crmIsDue(s)));
  const target = document.getElementById('crm-student-tbody');
  if (target) target.innerHTML = visible.length ? visible.map(s => {
    const last = crmSortedFollowups(s)[0];
    return `<tr class="${crmIsDue(s) ? 'crm-row-due' : ''}"><td><button class="crm-name" data-crm-action="open" data-crm-type="student" data-crm-id="${crmEsc(s.id)}">${crmEsc(s.name)}</button> ${crmGiftBadge(s)}<small>${crmEsc(s.phone || '未登记电话')}</small><small>${crmEsc(s.course)}</small></td><td>${crmIntentBadge(s.renewalIntent)}</td><td>${crmSummary(s.profile,'点击维护画像')}</td><td>${crmSummary(s.remarks)}</td><td>${last ? `<span>${crmEsc(last.time.replace('T',' ').slice(0,16))}</span>${crmSummary(last.action)}` : '<span class="crm-muted">暂无跟进记录</span>'}</td><td>${crmFollowDateCell(s,'student')}</td><td><div class="crm-table-actions">${crmButton('open','student',s.id,'维护档案','crm-btn-link')}${crmButton('follow','student',s.id,'＋ 跟进','crm-btn-soft')}</div></td></tr>`;
  }).join('') : '<tr><td colspan="7" class="crm-empty">没有匹配的学员。可清除筛选，或在下方新增学员。</td></tr>';
  const counts = document.getElementById('crm-student-count'); if (counts) counts.textContent = `${visible.length} / ${students.length} 人`;
  const dueCount = students.filter(s=>crmIsDue(s)).length;
  document.getElementById('crm-student-due-count').textContent = `${dueCount} 人待跟进`;
  const pq = (document.getElementById('crm-prospect-search')?.value || '').trim().toLowerCase();
  const pi = document.getElementById('crm-prospect-intent')?.value || '';
  const ps = document.getElementById('crm-prospect-status')?.value || '';
  const pd = document.getElementById('crm-prospect-due')?.checked;
  const pv = prospects.filter(p => (!pq || [p.name,p.phone,p.course,p.profile,p.remarks,...p.followUps.map(f=>f.action)].join(' ').toLowerCase().includes(pq)) && (!pi || p.enrollmentIntent===pi) && (!ps || p.status===ps) && (!pd || crmIsDue(p,'prospect')));
  document.getElementById('crm-prospect-count').textContent = `${pv.length} / ${prospects.length} 人`;
  document.getElementById('crm-prospect-total').textContent = prospects.filter(p=>!p.convertedStudentId && p.status!=='暂不报名').length;
  document.getElementById('crm-prospect-high').textContent = prospects.filter(p=>p.enrollmentIntent==='高'&&!p.convertedStudentId&&p.status!=='暂不报名').length;
  document.getElementById('crm-prospect-due-count').textContent = prospects.filter(p=>crmIsDue(p,'prospect')).length;
  document.getElementById('crm-prospect-converted').textContent = prospects.filter(p=>p.convertedStudentId).length;
  document.getElementById('crm-prospect-tbody').innerHTML = pv.length ? pv.map(p => {
    const last = crmSortedFollowups(p)[0]; const terminal = !!p.convertedStudentId;
    return `<tr class="${crmIsDue(p,'prospect') ? 'crm-row-due' : ''}"><td><button class="crm-name" data-crm-action="open" data-crm-type="prospect" data-crm-id="${crmEsc(p.id)}">${crmEsc(p.name)}</button> ${crmGiftBadge(p)}<small>${crmEsc(p.phone || '未登记电话')}</small></td><td>${crmSummary(p.course,'待沟通')}${crmSummary(p.profile,'画像待完善')}</td><td>${crmIntentBadge(p.enrollmentIntent)}</td><td><span class="crm-badge ${terminal ? 'crm-status-success' : 'crm-status'}">${crmEsc(p.status)}${terminal ? ' · 已转正式' : ''}</span></td><td>${crmSummary(p.remarks)}${last ? `<small>${crmEsc(last.time.replace('T',' ').slice(0,16))}</small>${crmSummary(last.action)}` : '<small>暂无跟进记录</small>'}</td><td>${crmFollowDateCell(p,'prospect')}</td><td><div class="crm-table-actions">${crmButton('open','prospect',p.id,'查看 / 编辑','crm-btn-link')}${terminal ? crmButton('converted','prospect',p.id,'正式档案','crm-btn-soft') : `${crmButton('follow','prospect',p.id,'＋ 跟进','crm-btn-soft')}${crmButton('convert','prospect',p.id,'转正式','crm-btn-primary')}`}</div></td></tr>`;
  }).join('') : `<tr><td colspan="7" class="crm-empty"><strong>${prospects.length ? '没有匹配的预备学员' : '从第一位有意向的学员开始'}</strong><span>${prospects.length ? '调整搜索词或筛选条件后重试。' : '先记录需求和报名意向，再安排一次跟进。报名后可一键转为正式学员。'}</span>${prospects.length ? '' : '<button class="crm-btn crm-btn-primary" data-crm-action="new">＋ 新增预备学员</button>'}</td></tr>`;
  const badge = document.getElementById('crm-prospect-nav-count'); if (badge) badge.textContent = prospects.filter(p=>crmIsDue(p,'prospect')).length || '';
}

function crmOpenRecord(type, id) {
  const fresh = type === 'prospect' && (id === undefined || id === null || id === '');
  const r = fresh ? normalizeCRMRecord({id:crmNewId(),name:'',phone:'',course:'',status:'待联系'},'prospect') : crmFind(type,id);
  if (!r) { crmToast('档案不存在或已被删除。',true); return; }
  normalizeCRMRecord(r,type); crmEditing = {type,id:r.id,fresh};
  document.getElementById('crm-record-title').textContent = fresh ? '新增预备学员' : `${r.name} · ${type === 'prospect' ? '预备学员档案' : '学员维护档案'}`;
  document.getElementById('crm-record-subtitle').textContent = type === 'prospect' ? '记录报名需求、画像与每一次沟通。' : '完善画像，判断续费意向，持续记录跟进。';
  document.getElementById('crm-record-name').value = r.name;
  document.getElementById('crm-record-name').readOnly = type !== 'prospect' || !!r.convertedStudentId;
  document.getElementById('crm-record-phone').value = r.phone;
  document.getElementById('crm-record-is-gift').checked = r.isGift;
  document.getElementById('crm-record-course').value = r.course || '';
  document.getElementById('crm-record-course').readOnly = type !== 'prospect' || !!r.convertedStudentId;
  document.getElementById('crm-record-intent-label').textContent = type === 'prospect' ? '报名意向' : '续费意向';
  document.getElementById('crm-record-intent').value = type === 'prospect' ? r.enrollmentIntent : r.renewalIntent;
  document.getElementById('crm-record-status-wrap').hidden = type !== 'prospect';
  document.getElementById('crm-record-status').value = r.status || '待联系';
  document.getElementById('crm-record-status').disabled = !!r.convertedStudentId;
  document.getElementById('crm-record-profile').value = r.profile;
  document.getElementById('crm-record-remarks').value = r.remarks;
  document.getElementById('crm-record-next').value = r.nextFollowupAt;
  document.getElementById('crm-record-delete').hidden = type !== 'prospect' || fresh;
  document.getElementById('crm-record-convert').hidden = type !== 'prospect' || fresh || !!r.convertedStudentId;
  document.getElementById('crm-record-linked').hidden = !r.convertedStudentId;
  document.getElementById('crm-record-add-follow').disabled = fresh;
  document.getElementById('crm-record-history-help').textContent = fresh ? '先保存档案，再添加第一条跟进。' : '每次沟通单独记录，历史不会被覆盖。';
  document.getElementById('crm-record-error').textContent = '';
  crmRenderHistory(r,type); crmOpenDialog('crm-record-dialog');
}
function crmSaveRecord(event, close = true) {
  event.preventDefault(); if (!crmEditing) return false;
  const {type,id,fresh} = crmEditing; const old = fresh ? {} : crmFind(type,id);
  if (!old) return false;
  const name = document.getElementById('crm-record-name').value.trim();
  if (!name) { document.getElementById('crm-record-error').textContent = '请填写学员姓名。'; return false; }
  const phone = document.getElementById('crm-record-phone').value.trim();
  if (type === 'prospect' && prospects.some(p=>String(p.id)!==String(id) && p.name.trim()===name && String(p.phone||'').trim()===phone)) { document.getElementById('crm-record-error').textContent = '该姓名和电话的预备学员已存在，请维护已有档案。'; return false; }
  Object.assign(old, {id,phone,isGift:document.getElementById('crm-record-is-gift').checked,profile:document.getElementById('crm-record-profile').value.trim(),remarks:document.getElementById('crm-record-remarks').value.trim(),nextFollowupAt:document.getElementById('crm-record-next').value});
  if (type==='prospect') {
    Object.assign(old,{name,course:document.getElementById('crm-record-course').value.trim(),enrollmentIntent:document.getElementById('crm-record-intent').value,status:old.convertedStudentId ? '已报名' : document.getElementById('crm-record-status').value});
    if (fresh) prospects.push(normalizeCRMRecord(old,'prospect'));
  } else old.renewalIntent = document.getElementById('crm-record-intent').value;
  persist(); if(close){crmCloseDialog('crm-record-dialog'); crmToast(fresh ? '预备学员已建档，可以开始跟进了。' : '档案已保存。');} return true;
}
function crmRenderHistory(r,type) {
  const fs = crmSortedFollowups(r); document.getElementById('crm-history-count').textContent = `${fs.length} 条`;
  document.getElementById('crm-record-history').innerHTML = fs.length ? fs.map(f=>`<article class="crm-history-item"><div class="crm-history-head"><strong>${crmEsc(f.time.replace('T',' ').slice(0,16))}</strong><span class="crm-badge crm-status">${crmEsc(f.method)}</span><span class="crm-history-actions"><button type="button" class="crm-btn crm-btn-link" data-crm-action="edit-follow" data-crm-type="${type}" data-crm-id="${crmEsc(r.id)}" data-crm-follow-id="${crmEsc(f.id)}">编辑</button><button type="button" class="crm-btn crm-btn-danger-link" data-crm-action="delete-follow" data-crm-type="${type}" data-crm-id="${crmEsc(r.id)}" data-crm-follow-id="${crmEsc(f.id)}">删除</button></span></div><p class="crm-history-action">${crmEsc(f.action)}</p>${f.result ? `<p><b>反馈结果</b>${crmEsc(f.result)}</p>` : ''}${f.nextPlan ? `<p><b>下一步</b>${crmEsc(f.nextPlan)}</p>` : ''}${f.nextDate ? `<div class="crm-follow-task ${!f.completed && f.nextDate<=crmToday() ? 'crm-follow-task-due' : ''}"><span>${f.completed ? '✓ 已完成计划' : '○ 待完成计划'} · ${crmEsc(f.nextDate)}</span><button type="button" class="crm-btn crm-btn-link" data-crm-action="toggle-follow" data-crm-type="${type}" data-crm-id="${crmEsc(r.id)}" data-crm-follow-id="${crmEsc(f.id)}">${f.completed ? '重新待跟进' : '标记完成'}</button></div>` : ''}</article>`).join('') : '<div class="crm-history-empty">暂无跟进记录。记录一次沟通，保留动作、反馈和下一步计划。</div>';
}
function crmOpenFollowup(type,id,followId) {
  const r=crmFind(type,id); if (!r) return; const f=(r.followUps || []).find(f=>String(f.id)===String(followId));
  crmFollowupEditing={type,id,followId:f?.id || null};
  document.getElementById('crm-follow-title').textContent = `${f ? '编辑' : '新增'}跟进 · ${r.name}`;
  document.getElementById('crm-follow-time').value=(f?.time || crmNow()).slice(0,16);
  document.getElementById('crm-follow-method').value=f?.method || '微信';
  document.getElementById('crm-follow-action').value=f?.action || '';
  document.getElementById('crm-follow-result').value=f?.result || '';
  document.getElementById('crm-follow-plan').value=f?.nextPlan || '';
  document.getElementById('crm-follow-next').value=f?.nextDate || '';
  document.getElementById('crm-follow-completed').checked=f?.completed || false;
  document.getElementById('crm-follow-error').textContent=''; crmOpenDialog('crm-follow-dialog');
}
function crmSaveFollowup(event) {
  event.preventDefault(); if (!crmFollowupEditing) return;
  const {type,id,followId}=crmFollowupEditing; const r=crmFind(type,id); if (!r) return;
  const action=document.getElementById('crm-follow-action').value.trim(); const time=document.getElementById('crm-follow-time').value;
  if (!action || !time) { document.getElementById('crm-follow-error').textContent='请填写跟进时间和具体动作。'; return; }
  const old=r.followUps.find(f=>String(f.id)===String(followId)); const oldDate=old?.nextDate || '';
  const data={id:old?.id || crmNewId('f'),time,method:document.getElementById('crm-follow-method').value,action,result:document.getElementById('crm-follow-result').value.trim(),nextPlan:document.getElementById('crm-follow-plan').value.trim(),nextDate:document.getElementById('crm-follow-next').value,completed:document.getElementById('crm-follow-completed').checked};
  if (old) Object.assign(old,data); else r.followUps.push(data);
  if (oldDate && r.nextFollowupAt===oldDate) r.nextFollowupAt='';
  const next=crmPendingOnlyDate(r); if (next && (!r.nextFollowupAt || next < r.nextFollowupAt)) r.nextFollowupAt=next;
  if (type==='prospect' && r.status==='待联系') r.status='跟进中';
  persist(); crmCloseDialog('crm-follow-dialog'); crmToast('跟进记录已保存。');
  if (document.getElementById('crm-record-dialog').open && crmEditing?.type===type && String(crmEditing.id)===String(id)) { crmRenderHistory(r,type); document.getElementById('crm-record-next').value=r.nextFollowupAt; document.getElementById('crm-record-status').value=r.status || '待联系'; }
}
function crmDeleteFollowup(type,id,followId) {
  const r=crmFind(type,id); if (!r || !confirm('确定删除这条跟进记录？删除后无法恢复。')) return;
  const f=r.followUps.find(f=>String(f.id)===String(followId)); r.followUps=r.followUps.filter(f=>String(f.id)!==String(followId));
  if (f?.nextDate && r.nextFollowupAt===f.nextDate) r.nextFollowupAt=crmPendingOnlyDate(r);
  persist(); if (document.getElementById('crm-record-dialog').open) { crmRenderHistory(r,type); document.getElementById('crm-record-next').value=r.nextFollowupAt; } crmToast('跟进记录已删除。');
}
function crmToggleFollowup(type,id,followId) {
  const r=crmFind(type,id); const f=r?.followUps.find(f=>String(f.id)===String(followId)); if (!f) return;
  f.completed=!f.completed; if (r.nextFollowupAt===f.nextDate) r.nextFollowupAt='';
  const next=crmPendingOnlyDate(r); if(next && (!r.nextFollowupAt || next<r.nextFollowupAt)) r.nextFollowupAt=next;
  persist(); crmRenderHistory(r,type); document.getElementById('crm-record-next').value=r.nextFollowupAt; crmToast(f.completed ? '该跟进计划已标记完成。' : '该计划已重新设为待跟进。');
}
function crmDeleteProspect(id) {
  const p=crmFind('prospect',id); if (!p || !confirm(`确定删除预备学员「${p.name}」及其全部跟进记录？${p.convertedStudentId ? '已转入的正式学员档案会保留。' : ''}`)) return;
  prospects=prospects.filter(p=>String(p.id)!==String(id)); persist(); crmCloseDialog('crm-record-dialog'); crmToast('预备学员已删除。');
}
function crmOpenConvert(id) {
  const p=crmFind('prospect',id); if (!p) return;
  if (p.convertedStudentId) { crmToast('该预备学员已经转为正式学员。'); return; }
  crmConversionId=id; document.getElementById('crm-convert-name').textContent=p.name;
  document.getElementById('crm-convert-course').value=p.course || '专升本专业课一对一';
  document.getElementById('crm-convert-hours').value=''; document.getElementById('crm-convert-teacher').value='';
  const duplicate=students.find(s=>String(s.name).trim()===p.name.trim() || (p.phone.trim() && String(s.phone || '').trim()===p.phone.trim()));
  document.getElementById('crm-convert-error').textContent=duplicate ? `正式学员中已有同姓名或同电话档案「${duplicate.name}」。请先核对并修改信息，避免重复建档。` : '';
  document.getElementById('crm-convert-submit').disabled=!!duplicate; crmOpenDialog('crm-convert-dialog');
}
function crmConvert(event) {
  event.preventDefault(); const p=crmFind('prospect',crmConversionId); if (!p || p.convertedStudentId) return;
  const course=document.getElementById('crm-convert-course').value.trim(); const totalHours=Number(document.getElementById('crm-convert-hours').value); const teacher=document.getElementById('crm-convert-teacher').value.trim() || '待分配';
